# Copy to `.env` next to docker-compose.yml (`.env` is gitignored).
# Compose substitutes these into ports / environment / Traefik labels.

# Public URL browsers actually open (scheme + host [+ port], no trailing slash).
# Used for GM invite / room links from the HTTP API.
# LAN example:
# PUBLIC_ORIGIN=http://192.168.1.10:8042
# Behind your own reverse proxy / FQDN (HTTPS) — TLS stays on the proxy:
PUBLIC_ORIGIN=https://vtt.example.com

# Host port published by compose (container still listens on 3001).
PORT=8042

# Optional Traefik Docker labels (see docker-compose.yml). Defaults keep plain compose working.
# Set TRAEFIK_ENABLE=true and FQDN when attaching to an existing Traefik.
# No bundled Caddy/Traefik service — terminate TLS on your proxy.
TRAEFIK_ENABLE=false
FQDN=vtt.example.com
# TRAEFIK_ENTRYPOINTS=websecure
# TRAEFIK_TLS=true

# Optional image tag override for compose pull.
# DMS_IMAGE_TAG=latest
